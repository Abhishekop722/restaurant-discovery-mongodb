NODE_ENV=development
PORT=3000
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27017/biteexpress?replicaSet=rs0
MONGODB_DB=biteexpress
RATE_LIMIT_MAX=300
TRUST_PROXY=false
