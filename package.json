{
  "name": "restaurant-discovery-mongodb",
  "version": "0.1.0",
  "private": true,
  "description": "Restaurant discovery API for BiteExpress, backed by MongoDB",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx src/infra/seed/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm deps:check && pnpm knip && pnpm test:unit",
    "prepare": "husky",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx test/e2e/smoke.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "mongodb": "^7.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@testcontainers/mongodb": "^12.2.2",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-unicorn": "^80.0.0",
    "husky": "^9.1.7",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
